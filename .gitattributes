# Set default behavior to automatically normalize line endings
* text=auto

# Force text files to always use LF line endings across all platforms
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env.example text eol=lf

# Force binary files to be treated as binary (prevent git diff/normalization corruption)
*.task binary
*.ttf binary